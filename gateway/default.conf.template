# ${API_HOST}, ${API_PORT} and ${MAX_UPLOAD} are filled in from the container's environment at start-up.

upstream proximity_api {
    server ${API_HOST}:${API_PORT};
    keepalive 16;
}

server {
    listen 80;
    server_name _;

    # The image links access.log to stdout (for `docker logs`); also keep a real
    # file so the gateway-logs volume holds a persistent copy.
    access_log /dev/stdout;
    access_log /var/log/nginx/gateway_access.log;

    # Link files are ~0.5 MB; the API itself rejects anything over 64 MB.
    client_max_body_size ${MAX_UPLOAD};

    location = /gateway-health {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # Link files served over HTTP, so the API's "link=<URL>" mode can fetch them
    # (e.g. link=http://gateway/files/link.txt from inside the Docker network).
    location /files/ {
        alias /srv/links/;
        autoindex on;
        default_type text/plain;
    }

    location / {
        proxy_pass http://proximity_api;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }
}
